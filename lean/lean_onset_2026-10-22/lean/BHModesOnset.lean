/-! ### O5: the parametrisation -/

theorem A_pos (μ : ℝ) : 0 < 6 + μ ^ 2 := by positivity

theorem O5_s_sq (μ : ℝ) : (1 + 2 * 6 * δp μ) ^ 2 = 1 + 4 * 6 * q2p μ / 25 := by
  have := A_pos μ
  unfold δp q2p w; field_simp; ring

theorem O5_s_pos (μ : ℝ) (h0 : 0 ≤ μ) (h1 : μ ≤ 1) : 0 < 1 + 2 * 6 * δp μ := by
  have := A_pos μ
  have : 0 ≤ 1 - μ ^ 2 := by nlinarith
  unfold δp; positivity

theorem O5_delta_nonneg (μ : ℝ) (h0 : 0 ≤ μ) (h1 : μ ≤ 1) : 0 ≤ δp μ := by
  have := A_pos μ
  have : 0 ≤ 1 - μ ^ 2 := by nlinarith
  unfold δp; positivity

theorem w_nonneg (μ : ℝ) (h0 : 0 ≤ μ) : 0 ≤ w μ := by
  have := A_pos μ
  unfold w; positivity

theorem w_zero : w 0 = 0 := by unfold w; norm_num

theorem w_one : w 1 = 1 := by unfold w; norm_num

theorem w_continuous : Continuous w := by
  unfold w; exact Continuous.div (by fun_prop) (by fun_prop) fun μ => (A_pos μ).ne'

theorem w_strictMonoOn : StrictMonoOn w (Set.Icc 0 1) := by
  intro a ha b hb hab
  have hA := A_pos a; have hB := A_pos b
  unfold w
  rw [div_lt_div_iff₀ hA hB]
  have hab' : a * b ≤ 1 := by nlinarith [ha.1, ha.2, hb.1, hb.2]
  nlinarith [mul_pos (sub_pos.2 hab) (by linarith : (0:ℝ) < 42 - 7 * (a * b))]

theorem q2p_strictAntiOn : StrictAntiOn q2p (Set.Icc 0 1) := by
  intro a ha b hb hab
  have h := w_strictMonoOn ha hb hab
  have h0 := w_nonneg a ha.1
  unfold q2p; nlinarith

theorem O5_sqrt (μ : ℝ) (h0 : 0 ≤ μ) : Real.sqrt (1 - q2p μ) = w μ := by
  unfold q2p
  rw [show 1 - (1 - w μ ^ 2) = w μ ^ 2 by ring]
  exact Real.sqrt_sq (w_nonneg μ h0)

theorem O5_xH (μ : ℝ) (h0 : 0 ≤ μ) : xHp μ = 2 * (6 + μ ^ 2) / ((μ + 1) * (μ + 6)) := by
  have := A_pos μ
  have h1 : μ + 1 ≠ 0 := by linarith
  have h6 : μ + 6 ≠ 0 := by linarith
  have hw : 1 + 7 * μ / (6 + μ ^ 2) ≠ 0 := by positivity
  unfold xHp w; field_simp; ring

/-- U₋ in the parametrisation: with m = 6, δ = δ(μ) and x = t x_H(μ), U₋ = F(t, μ)/((μ + 1)³(μ + 6)). -/
theorem param_U (t μ : ℝ) (h0 : 0 ≤ μ) :
    Um 6 (δp μ) (t * xHp μ) = Fp t μ / ((μ + 1) ^ 3 * (μ + 6)) := by
  rw [O5_xH μ h0]
  have := A_pos μ
  have h1 : μ + 1 ≠ 0 := by linarith
  have h6 : μ + 6 ≠ 0 := by linarith
  unfold Um δp Fp; field_simp; ring

/-- For every q ∈ [0, 1] there is μ ∈ [0, 1] with w(μ) = √(1 − q²), so q(μ)² = q². -/
theorem param_of_q (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∃ μ, 0 ≤ μ ∧ μ ≤ 1 ∧ w μ = Real.sqrt (1 - q ^ 2) ∧ q2p μ = q ^ 2 := by
  have hs0 : 0 ≤ Real.sqrt (1 - q ^ 2) := Real.sqrt_nonneg _
  have hs1 : Real.sqrt (1 - q ^ 2) ≤ 1 := by
    rw [Real.sqrt_le_one]; nlinarith
  have hmem : Real.sqrt (1 - q ^ 2) ∈ Set.Icc (w 0) (w 1) := by rw [w_zero, w_one]; exact ⟨hs0, hs1⟩
  obtain ⟨μ, hμ, hwμ⟩ := intermediate_value_Icc (zero_le_one' ℝ) w_continuous.continuousOn hmem
  refine ⟨μ, hμ.1, hμ.2, hwμ, ?_⟩
  unfold q2p; rw [hwμ, Real.sq_sqrt (by nlinarith)]; ring

/-- TARGET.md's δ (δ ≥ 0, (1 + 2mδ)² = 1 + 4mq²/25, m = 6) is δ(μ) when q(μ)² = q². -/
theorem delta_of_q (μ q δ : ℝ) (h0 : 0 ≤ μ) (h1 : μ ≤ 1) (hμq : q2p μ = q ^ 2) (hδ0 : 0 ≤ δ)
    (hδ : (1 + 2 * 6 * δ) ^ 2 = 1 + 4 * 6 * q ^ 2 / 25) : δ = δp μ := by
  have hs := O5_s_sq μ
  rw [hμq, ← hδ] at hs
  have hpos := O5_s_pos μ h0 h1
  have h := (sq_eq_sq₀ (by linarith) hpos.le).mp hs.symm
  linarith

/-! ### O1: the onset is algebraic -/

theorem g_factor (μ : ℝ) : Fp 1 μ = 1024 * (μ + 15) * pμ μ := by unfold Fp pμ; ring

theorem p_strictMono : StrictMono pμ := by
  intro a b hab
  have key : pμ b - pμ a = (b - a) * (10 * (a ^ 2 + a * b + b ^ 2) - 11 * (a + b) + 228) := by unfold pμ; ring
  have hq : 0 < 10 * (a ^ 2 + a * b + b ^ 2) - 11 * (a + b) + 228 := by
    nlinarith [sq_nonneg (a + b - 11 / 15), sq_nonneg (a - b)]
  nlinarith [mul_pos (sub_pos.2 hab) hq]

theorem p_lo : pμ (19893240974 / 10 ^ 11) < 0 := by unfold pμ; norm_num

theorem p_hi : 0 < pμ (19893240975 / 10 ^ 11) := by unfold pμ; norm_num

theorem p_root_exists : ∃ μs, 19893240974 / 10 ^ 11 < μs ∧ μs < 19893240975 / 10 ^ 11 ∧ pμ μs = 0 := by
  have hc : Continuous pμ := by unfold pμ; fun_prop
  have hmem : (0 : ℝ) ∈ Set.Ioo (pμ (19893240974 / 10 ^ 11)) (pμ (19893240975 / 10 ^ 11)) := ⟨p_lo, p_hi⟩
  obtain ⟨μs, hμs, h⟩ := intermediate_value_Ioo (by norm_num) hc.continuousOn hmem
  exact ⟨μs, hμs.1, hμs.2, h⟩

theorem p_root_bounds (μs : ℝ) (h : pμ μs = 0) :
    19893240974 / 10 ^ 11 < μs ∧ μs < 19893240975 / 10 ^ 11 := by
  constructor
  · by_contra hc; push_neg at hc
    have := p_strictMono.monotone hc; linarith [p_lo]
  · by_contra hc; push_neg at hc
    have := p_strictMono.monotone hc; linarith [p_hi]

theorem p_root_unique (a b : ℝ) (ha : pμ a = 0) (hb : pμ b = 0) : a = b :=
  p_strictMono.injective (ha.trans hb.symm)

/-- The resultant relation: (6 + μ²)⁶ C(1 − w²) = p(μ) K(μ). -/
theorem C_relation (μ : ℝ) : (6 + μ ^ 2) ^ 6 * CY (q2p μ) = pμ μ * Kμ μ := by
  have := A_pos μ
  unfold CY q2p w pμ Kμ; field_simp; ring

theorem q2_root (μs : ℝ) (h : pμ μs = 0) : CY (q2p μs) = 0 := by
  have hr := C_relation μs
  rw [h, zero_mul] at hr
  exact (mul_eq_zero.1 hr).resolve_left (by have := A_pos μs; positivity)

theorem C_neg (Y : ℝ) (h : Y ≤ 0) : CY Y < 0 := by
  have h3 : Y ^ 3 ≤ 0 := by nlinarith [sq_nonneg Y]
  unfold CY; nlinarith [sq_nonneg Y]

theorem C_pos (Y : ℝ) (h : 1 ≤ Y) : 0 < CY Y := by
  have key : CY Y = 2500 + (Y - 1) * (3025 * (Y - 1) ^ 2 - 22446 * (Y - 1) + 45825) := by unfold CY; ring
  have hq : 0 < 3025 * (Y - 1) ^ 2 - 22446 * (Y - 1) + 45825 := by nlinarith [sq_nonneg (Y - 1 - 22446 / 6050)]
  rw [key]; nlinarith [mul_nonneg (sub_nonneg.2 h) hq.le]

theorem C_strictMonoOn : StrictMonoOn CY (Set.Icc 0 1) := by
  intro a ha b hb hab
  have key : CY b - CY a = (b - a) * (3025 * (a ^ 2 + a * b + b ^ 2) - 31521 * (a + b) + 99792) := by unfold CY; ring
  have hq : 0 < 3025 * (a ^ 2 + a * b + b ^ 2) - 31521 * (a + b) + 99792 := by
    nlinarith [ha.1, ha.2, hb.1, hb.2, mul_nonneg ha.1 hb.1]
  nlinarith [mul_pos (sub_pos.2 hab) hq]

/-- C has exactly one real root. -/
theorem C_root_unique (a b : ℝ) (ha : CY a = 0) (hb : CY b = 0) : a = b := by
  have ha0 : 0 ≤ a := by by_contra h; push_neg at h; linarith [C_neg a h.le]
  have ha1 : a ≤ 1 := by by_contra h; push_neg at h; linarith [C_pos a h.le]
  have hb0 : 0 ≤ b := by by_contra h; push_neg at h; linarith [C_neg b h.le]
  have hb1 : b ≤ 1 := by by_contra h; push_neg at h; linarith [C_pos b h.le]
  exact C_strictMonoOn.injOn ⟨ha0, ha1⟩ ⟨hb0, hb1⟩ (ha.trans hb.symm)

theorem qstar_sq_bounds (μs : ℝ) (h : pμ μs = 0) :
    (9730564367 / 10 ^ 10) ^ 2 < q2p μs ∧ q2p μs < (9730564368 / 10 ^ 10) ^ 2 := by
  obtain ⟨hlo, hhi⟩ := p_root_bounds μs h
  have m0 : (0:ℝ) ≤ 19893240974 / 10 ^ 11 := by norm_num
  have m1 : (19893240975 : ℝ) / 10 ^ 11 ≤ 1 := by norm_num
  have mem_s : μs ∈ Set.Icc (0:ℝ) 1 := ⟨by linarith, by linarith⟩
  have h1 := q2p_strictAntiOn mem_s ⟨by linarith, m1⟩ hhi
  have h2 := q2p_strictAntiOn ⟨m0, by linarith⟩ mem_s hlo
  have e1 : (9730564367 / 10 ^ 10 : ℝ) ^ 2 < q2p (19893240975 / 10 ^ 11) := by unfold q2p w; norm_num
  have e2 : q2p (19893240974 / 10 ^ 11) < (9730564368 / 10 ^ 10 : ℝ) ^ 2 := by unfold q2p w; norm_num
  exact ⟨e1.trans h1, h2.trans e2⟩

/-- q_* = √(q(μ_*)²) lies in the registered prediction [0.9730564367, 0.9730564368]. -/
theorem qstar_bounds (μs : ℝ) (h : pμ μs = 0) :
    9730564367 / 10 ^ 10 < Real.sqrt (q2p μs) ∧ Real.sqrt (q2p μs) < 9730564368 / 10 ^ 10 := by
  obtain ⟨b1, b2⟩ := qstar_sq_bounds μs h
  constructor
  · exact Real.lt_sqrt_of_sq_lt b1
  · rw [Real.sqrt_lt' (by norm_num)]; exact b2

/-! ### The three Bernstein boxes -/

theorem B1_pos (u ub v vb : ℝ) (hu : 0 ≤ u) (hub : 0 ≤ ub) (hv : 0 ≤ v) (hvb : 0 ≤ vb)
    (hsu : u + ub = 1) (hsv : v + vb = 1) : 0 < B1 u ub v vb := by
  rw [B1_split, hsu, hsv]; positivity

theorem B2_pos (u ub v vb : ℝ) (hu : 0 ≤ u) (hub : 0 ≤ ub) (hv : 0 ≤ v) (hvb : 0 ≤ vb)
    (hsu : u + ub = 1) (hsv : v + vb = 1) : 0 < B2 u ub v vb := by
  rw [B2_split, hsu, hsv]; positivity

theorem B3_pos (u ub v vb : ℝ) (hu : 0 ≤ u) (hub : 0 ≤ ub) (hv : 0 ≤ v) (hvb : 0 ≤ vb)
    (hsu : u + ub = 1) (hsv : v + vb = 1) : 0 < B3 u ub v vb := by
  rw [B3_split, hsu, hsv]; positivity

/-- Box 1: F > 0 on [0, 7/8] × [1/6, 1]. -/
theorem box1 (t μ : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 7 / 8) (hμ0 : 1 / 6 ≤ μ) (hμ1 : μ ≤ 1) : 0 < Fp t μ := by
  have e : Fp t μ = B1 (8 * t / 7) (1 - 8 * t / 7) ((6 * μ - 1) / 5) (1 - (6 * μ - 1) / 5) := by
    unfold Fp B1; ring
  rw [e]
  exact B1_pos _ _ _ _ (by linarith) (by linarith) (by linarith) (by linarith) (by ring) (by ring)

/-- Box 2: F > 0 on [7/8, 1] × [1/4, 1]. -/
theorem box2 (t μ : ℝ) (ht0 : 7 / 8 ≤ t) (ht1 : t ≤ 1) (hμ0 : 1 / 4 ≤ μ) (hμ1 : μ ≤ 1) : 0 < Fp t μ := by
  have e : Fp t μ = B2 (8 * t - 7) (1 - (8 * t - 7)) ((4 * μ - 1) / 3) (1 - (4 * μ - 1) / 3) := by
    unfold Fp B2; ring
  rw [e]
  exact B2_pos _ _ _ _ (by linarith) (by linarith) (by linarith) (by linarith) (by ring) (by ring)

/-- Box 3 (the corner): Q < 0 on [7/8, 1] × [1/6, 1/4], where F(t, μ) = F(1, μ) + (t − 1) Q(t, μ). -/
theorem box3 (t μ : ℝ) (ht0 : 7 / 8 ≤ t) (ht1 : t ≤ 1) (hμ0 : 1 / 6 ≤ μ) (hμ1 : μ ≤ 1 / 4) : Qp t μ < 0 := by
  have e : -Qp t μ = B3 (8 * t - 7) (1 - (8 * t - 7)) (12 * μ - 2) (1 - (12 * μ - 2)) := by
    unfold Qp B3; ring
  have := B3_pos (8 * t - 7) (1 - (8 * t - 7)) (12 * μ - 2) (1 - (12 * μ - 2))
    (by linarith) (by linarith) (by linarith) (by linarith) (by ring) (by ring)
  linarith

theorem F_split (t μ : ℝ) : Fp t μ = Fp 1 μ + (t - 1) * Qp t μ := by unfold Fp Qp; ring

/-! ### O2 and O3 in the parametrisation -/

theorem lo_gt_sixth : (1 : ℝ) / 6 < 19893240974 / 10 ^ 11 := by norm_num

theorem hi_lt_quarter : (19893240975 : ℝ) / 10 ^ 11 < 1 / 4 := by norm_num

/-- O2 in (t, μ): for μ_* ≤ μ ≤ 1 and 0 ≤ t ≤ 1, F(t, μ) ≥ 0, with equality only at (t, μ) = (1, μ_*). -/
theorem O2_mu (μs μ t : ℝ) (hs : pμ μs = 0) (hμ : μs ≤ μ) (hμ1 : μ ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ Fp t μ ∧ (Fp t μ = 0 → t = 1 ∧ μ = μs) := by
  obtain ⟨hlo, hhi⟩ := p_root_bounds μs hs
  have hμ6 : 1 / 6 ≤ μ := by linarith [lo_gt_sixth]
  by_cases ht : t ≤ 7 / 8
  · have h := box1 t μ ht0 ht hμ6 hμ1
    exact ⟨h.le, fun h0 => absurd h0 h.ne'⟩
  push_neg at ht
  by_cases hm : 1 / 4 ≤ μ
  · have h := box2 t μ ht.le ht1 hm hμ1
    exact ⟨h.le, fun h0 => absurd h0 h.ne'⟩
  push_neg at hm
  have hQ := box3 t μ ht.le ht1 hμ6 hm.le
  have hp : 0 ≤ pμ μ := by rw [← hs]; exact p_strictMono.monotone hμ
  have hg : 0 ≤ Fp 1 μ := by
    rw [g_factor]
    have h15 : 0 < μ + 15 := by linarith
    positivity
  have hT : 0 ≤ (t - 1) * Qp t μ := mul_nonneg_of_nonpos_of_nonpos (by linarith) hQ.le
  rw [F_split t μ]
  refine ⟨by linarith, fun h0 => ?_⟩
  have hg0 : Fp 1 μ = 0 := by linarith
  have hT0 : (t - 1) * Qp t μ = 0 := by linarith
  have ht' : t = 1 := by
    rcases mul_eq_zero.1 hT0 with h | h
    · linarith
    · exact absurd h hQ.ne
  refine ⟨ht', ?_⟩
  rw [g_factor] at hg0
  have hp0 : pμ μ = 0 := by
    rcases mul_eq_zero.1 hg0 with h | h
    · rcases mul_eq_zero.1 h with h' | h'
      · norm_num at h'
      · linarith
    · exact h
  exact p_root_unique μ μs hp0 hs

/-- O3 in μ: for 0 ≤ μ < μ_*, F(1, μ) < 0 (U₋ < 0 at the horizon). -/
theorem O3_mu (μs μ : ℝ) (hs : pμ μs = 0) (hμ0 : 0 ≤ μ) (hμ : μ < μs) : Fp 1 μ < 0 := by
  have hp : pμ μ < 0 := by rw [← hs]; exact p_strictMono hμ
  rw [g_factor]
  have : 0 < 1024 * (μ + 15) := by linarith
  nlinarith

/-! ### O2, O3 and O4 in q (TARGET.md §1's δ and x_H) -/

/-- O2: for 0 ≤ q with q² ≤ q_*², TARGET.md's δ, and 0 ≤ x ≤ x_H(q): U₋(x) ≥ 0. -/
theorem O2 (μs q δ x : ℝ) (hs : pμ μs = 0) (hq0 : 0 ≤ q) (hq : q ^ 2 ≤ q2p μs) (hδ0 : 0 ≤ δ)
    (hδ : (1 + 2 * 6 * δ) ^ 2 = 1 + 4 * 6 * q ^ 2 / 25) (hx0 : 0 ≤ x)
    (hx : x ≤ 2 / (1 + Real.sqrt (1 - q ^ 2))) : 0 ≤ Um 6 δ x := by
  obtain ⟨hlo, hhi⟩ := p_root_bounds μs hs
  have hs01 : μs ∈ Set.Icc (0:ℝ) 1 := ⟨by linarith [lo_gt_sixth], by linarith [hi_lt_quarter]⟩
  have hq2le : q2p μs ≤ 1 := by unfold q2p; nlinarith [sq_nonneg (w μs)]
  have hq1 : q ≤ 1 := by nlinarith
  obtain ⟨μ, hμ0, hμ1, hwμ, hμq⟩ := param_of_q q hq0 hq1
  have hμs : μs ≤ μ := by
    by_contra hc; push_neg at hc
    have := q2p_strictAntiOn ⟨hμ0, hμ1⟩ hs01 hc
    linarith
  have hδμ := delta_of_q μ q δ hμ0 hμ1 hμq hδ0 hδ
  have hxH : 2 / (1 + Real.sqrt (1 - q ^ 2)) = xHp μ := by unfold xHp; rw [hwμ]
  have hxHpos : 0 < xHp μ := by unfold xHp; have := w_nonneg μ hμ0; positivity
  set t := x / xHp μ with ht
  have hxt : x = t * xHp μ := by rw [ht]; field_simp
  have ht0 : 0 ≤ t := by rw [ht]; positivity
  have ht1 : t ≤ 1 := by rw [ht, div_le_one hxHpos]; linarith [hxH ▸ hx]
  rw [hδμ, hxt, param_U t μ hμ0]
  have := (O2_mu μs μ t hs hμs hμ1 ht0 ht1).1
  positivity

/-- O3: for q ≤ 1 with q² > q_*², TARGET.md's δ: U₋(x_H(q)) < 0. -/
theorem O3 (μs q δ : ℝ) (hs : pμ μs = 0) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hq : q2p μs < q ^ 2) (hδ0 : 0 ≤ δ)
    (hδ : (1 + 2 * 6 * δ) ^ 2 = 1 + 4 * 6 * q ^ 2 / 25) :
    Um 6 δ (2 / (1 + Real.sqrt (1 - q ^ 2))) < 0 := by
  obtain ⟨hlo, hhi⟩ := p_root_bounds μs hs
  have hs01 : μs ∈ Set.Icc (0:ℝ) 1 := ⟨by linarith [lo_gt_sixth], by linarith [hi_lt_quarter]⟩
  obtain ⟨μ, hμ0, hμ1, hwμ, hμq⟩ := param_of_q q hq0 hq1
  have hμs : μ < μs := by
    by_contra hc; push_neg at hc
    have := q2p_strictAntiOn.antitoneOn hs01 ⟨hμ0, hμ1⟩ hc
    linarith
  have hδμ := delta_of_q μ q δ hμ0 hμ1 hμq hδ0 hδ
  have hxH : 2 / (1 + Real.sqrt (1 - q ^ 2)) = 1 * xHp μ := by unfold xHp; rw [hwμ, one_mul]
  rw [hδμ, hxH, param_U 1 μ hμ0]
  have := O3_mu μs μ hs hμ0 hμs
  have : 0 < (μ + 1) ^ 3 * (μ + 6) := by positivity
  exact div_neg_of_neg_of_pos (by assumption) this

/-- O4: Kodama–Ishibashi (6.24)'s bracket at the horizon, b = 2m − 10(1 + mδ)x_H, is 4(4μ − 3)/(μ + 1). -/
theorem O4_bracket (μ : ℝ) (h0 : 0 ≤ μ) : 2 * 6 - 10 * (1 + 6 * δp μ) * xHp μ = 4 * (4 * μ - 3) / (μ + 1) := by
  rw [O5_xH μ h0]
  have := A_pos μ
  have h1 : μ + 1 ≠ 0 := by linarith
  have h6 : μ + 6 ≠ 0 := by linarith
  unfold δp; field_simp; ring

theorem O4_threshold : q2p (3 / 4) = 9 / 25 := by unfold q2p w; norm_num

/-- O4 in q: for 0 ≤ q ≤ 1 and TARGET.md's δ, the bracket at the horizon is > 0 if q < 3/5, = 0 if q = 3/5,
< 0 if q > 3/5. -/
theorem O4 (q δ : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hδ0 : 0 ≤ δ) (hδ : (1 + 2 * 6 * δ) ^ 2 = 1 + 4 * 6 * q ^ 2 / 25) :
    let b := 2 * 6 - 10 * (1 + 6 * δ) * (2 / (1 + Real.sqrt (1 - q ^ 2)))
    (q < 3 / 5 → 0 < b) ∧ (q = 3 / 5 → b = 0) ∧ (3 / 5 < q → b < 0) := by
  intro b
  obtain ⟨μ, hμ0, hμ1, hwμ, hμq⟩ := param_of_q q hq0 hq1
  have hδμ := delta_of_q μ q δ hμ0 hμ1 hμq hδ0 hδ
  have hb : b = 4 * (4 * μ - 3) / (μ + 1) := by
    show 2 * 6 - 10 * (1 + 6 * δ) * (2 / (1 + Real.sqrt (1 - q ^ 2))) = _
    rw [← hwμ, hδμ]; exact O4_bracket μ hμ0
  have hm34 : (3:ℝ) / 4 ∈ Set.Icc (0:ℝ) 1 := ⟨by norm_num, by norm_num⟩
  have hpos : 0 < μ + 1 := by linarith
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · have : 3 / 4 < μ := by
      by_contra hc; push_neg at hc
      have := q2p_strictAntiOn.antitoneOn ⟨hμ0, hμ1⟩ hm34 hc
      rw [O4_threshold, hμq] at this; nlinarith
    rw [hb]; apply div_pos _ hpos; linarith
  · have : μ = 3 / 4 := by
      apply q2p_strictAntiOn.injOn ⟨hμ0, hμ1⟩ hm34
      rw [hμq, O4_threshold, h]; norm_num
    rw [hb, this]; norm_num
  · have : μ < 3 / 4 := by
      by_contra hc; push_neg at hc
      have := q2p_strictAntiOn.antitoneOn hm34 ⟨hμ0, hμ1⟩ hc
      rw [O4_threshold, hμq] at this; nlinarith
    rw [hb]; apply div_neg_of_neg_of_pos _ hpos; linarith

/-! ### Minimality: both cubics are irreducible over ℚ -/

/-- The rational root theorem for a cubic, denominator part. -/
theorem cubic_den_dvd (r : ℚ) (a b c e : ℤ) (h : (a : ℚ) * r ^ 3 + b * r ^ 2 + c * r + e = 0) :
    (r.den : ℤ) ∣ a := by
  set n := r.num with hn
  set d := r.den with hd
  have hd0 : (d : ℚ) ≠ 0 := by rw [hd]; exact_mod_cast r.den_nz
  have hr : r = n / d := (Rat.num_div_den r).symm
  have key : a * n ^ 3 + b * n ^ 2 * d + c * n * d ^ 2 + e * d ^ 3 = 0 := by
    have h' : (a : ℚ) * n ^ 3 + b * n ^ 2 * d + c * n * d ^ 2 + e * d ^ 3 = 0 := by
      rw [hr] at h; field_simp at h; linear_combination h
    exact_mod_cast h'
  have hdvd : (d : ℤ) ∣ a * n ^ 3 :=
    ⟨-(b * n ^ 2 + c * n * d + e * d ^ 2), by linear_combination key⟩
  have hcop : IsCoprime (d : ℤ) (n ^ 3) := by
    apply IsCoprime.pow_right
    rw [Int.isCoprime_iff_gcd_eq_one]
    have hred := r.reduced
    rw [← hn, ← hd] at hred
    rw [Int.gcd_comm]
    simpa [Int.gcd] using hred
  exact hcop.dvd_of_dvd_mul_right hdvd

theorem p_no_rat_root (x : ℚ) : (10 : ℚ) * x ^ 3 - 11 * x ^ 2 + 228 * x - 45 ≠ 0 := by
  intro h
  have hreal : pμ (x : ℝ) = 0 := by unfold pμ; exact_mod_cast h
  obtain ⟨hlo, hhi⟩ := p_root_bounds _ hreal
  have hdv := cubic_den_dvd x 10 (-11) 228 (-45) (by push_cast; linear_combination h)
  obtain ⟨k, hk⟩ := hdv
  have h10 : (10 : ℚ) * x = x.num * k := by
    have hd0 : (x.den : ℚ) ≠ 0 := by exact_mod_cast x.den_nz
    have hk' : (10 : ℚ) = x.den * k := by exact_mod_cast hk
    have hx : x = x.num / x.den := (Rat.num_div_den x).symm
    calc (10 : ℚ) * x = (x.den * k) * (x.num / x.den) := by rw [← hk', ← hx]
      _ = x.num * k := by field_simp
  have h10r : (10 : ℝ) * (x : ℝ) = ((x.num * k : ℤ) : ℝ) := by push_cast; exact_mod_cast h10
  have h1 : ((1 : ℤ) : ℝ) < ((x.num * k : ℤ) : ℝ) := by rw [← h10r]; push_cast; linarith
  have h2 : ((x.num * k : ℤ) : ℝ) < ((2 : ℤ) : ℝ) := by rw [← h10r]; push_cast; linarith
  have := Int.cast_lt.mp h1; have := Int.cast_lt.mp h2; omega

theorem C_no_rat_root (y : ℚ) : (3025 : ℚ) * y ^ 3 - 31521 * y ^ 2 + 99792 * y - 68796 ≠ 0 := by
  intro h
  have hreal : CY (y : ℝ) = 0 := by unfold CY; exact_mod_cast h
  obtain ⟨μs, -, -, hμs⟩ := p_root_exists
  have heq := C_root_unique _ _ hreal (q2_root μs hμs)
  obtain ⟨b1, b2⟩ := qstar_sq_bounds μs hμs
  rw [← heq] at b1 b2
  have hdv := cubic_den_dvd y 3025 (-31521) 99792 (-68796) (by push_cast; linear_combination h)
  obtain ⟨k, hk⟩ := hdv
  have h3 : (3025 : ℚ) * y = y.num * k := by
    have hd0 : (y.den : ℚ) ≠ 0 := by exact_mod_cast y.den_nz
    have hk' : (3025 : ℚ) = y.den * k := by exact_mod_cast hk
    have hx : y = y.num / y.den := (Rat.num_div_den y).symm
    calc (3025 : ℚ) * y = (y.den * k) * (y.num / y.den) := by rw [← hk', ← hx]
      _ = y.num * k := by field_simp
  have h3r : (3025 : ℝ) * (y : ℝ) = ((y.num * k : ℤ) : ℝ) := by push_cast; exact_mod_cast h3
  have e1 : (2864 : ℝ) < 3025 * (9730564367 / 10 ^ 10) ^ 2 := by norm_num
  have e2 : (3025 : ℝ) * (9730564368 / 10 ^ 10) ^ 2 < 2865 := by norm_num
  have h1 : ((2864 : ℤ) : ℝ) < ((y.num * k : ℤ) : ℝ) := by rw [← h3r]; push_cast; nlinarith
  have h2 : ((y.num * k : ℤ) : ℝ) < ((2865 : ℤ) : ℝ) := by rw [← h3r]; push_cast; nlinarith
  have := Int.cast_lt.mp h1; have := Int.cast_lt.mp h2; omega

open Polynomial in
/-- 10μ³ − 11μ² + 228μ − 45 is irreducible over ℚ (so it is the minimal polynomial of μ_*, up to the factor 10). -/
theorem p_irreducible : Irreducible (C (10 : ℚ) * X ^ 3 - C 11 * X ^ 2 + C 228 * X - C 45) := by
  have hdeg : (C (10 : ℚ) * X ^ 3 - C 11 * X ^ 2 + C 228 * X - C 45).natDegree = 3 := by compute_degree!
  apply irreducible_of_degree_le_three_of_not_isRoot
  · rw [hdeg, Finset.mem_Icc]; constructor <;> norm_num
  · intro x hx
    apply p_no_rat_root x
    simpa [IsRoot] using hx

open Polynomial in
/-- 3025Y³ − 31521Y² + 99792Y − 68796 is irreducible over ℚ (so it is the minimal polynomial of q_*², up to the
factor 3025). -/
theorem C_irreducible : Irreducible (C (3025 : ℚ) * X ^ 3 - C 31521 * X ^ 2 + C 99792 * X - C 68796) := by
  have hdeg : (C (3025 : ℚ) * X ^ 3 - C 31521 * X ^ 2 + C 99792 * X - C 68796).natDegree = 3 := by compute_degree!
  apply irreducible_of_degree_le_three_of_not_isRoot
  · rw [hdeg, Finset.mem_Icc]; constructor <;> norm_num
  · intro y hy
    apply C_no_rat_root y
    simpa [IsRoot] using hy

end BHModes.Onset
