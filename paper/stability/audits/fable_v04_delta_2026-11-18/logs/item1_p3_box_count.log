69	def prove_sign(p, box, sign, max_depth, stats, label, minrec=None):
70	    """Prove sign * p > 0 on the closed box by adaptive bisection; raise CertificateError if
71	    a leaf at max_depth is still undecided or a corner value has the wrong sign.  If a dict
72	    minrec is given, minrec[label] is the least Bernstein coefficient of sign * p over the
73	    accepted leaves: a certified lower bound of sign * p on the box."""
74	    stack = [(box, 0)]
75	    while stack:
76	        (t0, t1, m0, m1), depth = stack.pop()
77	        b = p.bernstein(t0, t1, m0, m1)
78	        lo = min(sign * c for row in b for c in row)
79	        stats[label] = stats.get(label, 0) + 1
80	        if lo > 0:
81	            if minrec is not None:
82	                minrec[label] = lo if label not in minrec else min(minrec[label], lo)
83	            continue
84	        for (tt, mm) in ((t0, m0), (t0, m1), (t1, m0), (t1, m1)):
85	            if sign * p.value(tt, mm) <= 0:
86	                raise CertificateError(f"{label}: sign*p = {sign * p.value(tt, mm)} <= 0 at "
87	                                       f"(t, mu) = ({tt}, {mm})  (a counterexample)")
88	        if depth >= max_depth:
89	            raise CertificateError(f"{label}: undecided at depth {depth} on box {(t0, t1, m0, m1)}")
90	        # bisect the side whose Bernstein coefficients vary more (never a variable p lacks)
91	        if p.dm == 0 or (p.dt > 0 and (t1 - t0) * p.dt >= (m1 - m0) * p.dm):
92	            tm = (t0 + t1) / 2
93	            stack += [((t0, tm, m0, m1), depth + 1), ((tm, t1, m0, m1), depth + 1)]
94	        else:
95	            mm_ = (m0 + m1) / 2
96	            stack += [((t0, t1, m0, mm_), depth + 1), ((t0, t1, mm_, m1), depth + 1)]
97	    return True
