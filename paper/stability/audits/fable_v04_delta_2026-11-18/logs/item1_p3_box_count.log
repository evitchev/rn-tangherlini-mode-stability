208	def verify(S, P, mbox, stats, label, pieces=None, extra=0):
209	    """N > 0 on [0, 1] x mbox (mbox = (a, b); a = b for a point), via N L > 0 and L > 0."""
210	    a, b = (Q(v) for v in mbox)
211	    point = mbox[0] == mbox[1]
212	    pp = parts(S, mbox[0] if point and S["n"] == 4 else None)
213	    if point and S["n"] == 4:
214	        P = P.subs(mu, R(mbox[0]))
215	    NL, L = N_times_L(pp, P, extra)
216	    Lp = poly2_of(L)
217	    prove_sign(Lp, (fmpq(0), fmpq(1), a, b), 1, 30, stats, label + ": L > 0")
218	    p2 = poly2_of(NL)
219	    for (z0, z1) in (pieces or [(fmpq(0), fmpq(1))]):
220	        prove_sign(p2, (z0, z1, a, b), 1, 40, stats, label + ": N > 0")
221	    return {"deg_z": p2.dt, "deg_mu": p2.dm}
222	
