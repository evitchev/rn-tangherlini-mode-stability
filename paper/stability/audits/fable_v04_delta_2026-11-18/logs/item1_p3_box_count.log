143	    expr = U.subs({m: P["m"], d: P["delta"]}).subs(x, t * P["xH"])
144	    num, den = sp.fraction(sp.cancel(sp.together(expr)))
145	    if den.has(t):
146	        raise CertificateError(f"n={n} l={ell}: denominator depends on t")
147	    sg = 1 if sp.Poly(den, mu).eval(sp.Rational(1, 2)) > 0 else -1
148	    F, Den = sp.expand(sg * num), sp.expand(sg * den)
149	    if sp.cancel(F / Den - expr) != 0:
150	        raise CertificateError(f"n={n} l={ell}: F/Den differs from U_-")
151	    Fp = sp.Poly(F, t, mu)
152	    rec.update({"F_degrees": [Fp.degree(t), Fp.degree(mu)], "Den": str(sp.factor(Den))})
153	    positive_mu(verify, Den, mu_lo, 1, stats, minrec, "Den")
154	    F2 = Poly2({(i, j): Q(c) for (i, j), c in Fp.terms()})
155	    verify(F2, (fmpq(0), fmpq(1), Q(mu_lo), fmpq(1)), 1, MAX_DEPTH, stats, "F", minrec)
156	    den2 = Poly2({(0, j): Q(c) for (j,), c in sp.Poly(Den, mu).terms()})
157	    den_max = max(c for row in den2.bernstein(fmpq(0), fmpq(1), Q(mu_lo), fmpq(1)) for c in row)
158	    lower = minrec["F"] / den_max
159	    rec.update({"bernstein_leaves": stats["F"], "U_lower_bound": str(lower)})
160	    return rec
